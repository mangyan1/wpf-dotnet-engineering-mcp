<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets/AppIcon.ico</ApplicationIcon>
    <AssemblyName>EngineeringMcp.ControlCenter</AssemblyName>
    <RootNamespace>EngineeringMcp.ControlCenter</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/Fonts/*.ttf" />
    <Resource Include="Assets/AppIcon.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../EngineeringMcp.Contracts/EngineeringMcp.Contracts.csproj" />
    <ProjectReference Include="../EngineeringMcp.Security/EngineeringMcp.Security.csproj" />
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>
</Project>
