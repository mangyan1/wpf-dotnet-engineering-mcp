<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Fonts.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- control-room dark palette (docs/mockups/control-center.html) -->
    <SolidColorBrush x:Key="BgBrush" Color="#0a0c0f" />
    <SolidColorBrush x:Key="Bg2Brush" Color="#0d1014" />
    <SolidColorBrush x:Key="PanelBrush" Color="#10141a" />
    <SolidColorBrush x:Key="Panel2Brush" Color="#151a21" />
    <SolidColorBrush x:Key="RaiseBrush" Color="#1a2029" />
    <SolidColorBrush x:Key="StrokeBrush" Color="#1f2630" />
    <SolidColorBrush x:Key="Stroke2Brush" Color="#1a2029" />
    <SolidColorBrush x:Key="HairBrush" Color="#252d38" />
    <SolidColorBrush x:Key="GridLineBrush" Color="#263140" />
    <SolidColorBrush x:Key="TextBrush" Color="#e9e4d8" />
    <SolidColorBrush x:Key="Text2Brush" Color="#a09a8c" />
    <SolidColorBrush x:Key="Text3Brush" Color="#5f6470" />
    <SolidColorBrush x:Key="AmberBrush" Color="#ffb224" />
    <SolidColorBrush x:Key="AmberDimBrush" Color="#c98a1a" />
    <SolidColorBrush x:Key="AmberGlowBrush" Color="#ffb224" Opacity="0.12" />
    <SolidColorBrush x:Key="AmberTextBrush" Color="#141005" />
    <SolidColorBrush x:Key="GreenBrush" Color="#4ade80" />
    <SolidColorBrush x:Key="RedBrush" Color="#f87171" />
    <SolidColorBrush x:Key="CyanBrush" Color="#67e8f9" />
    <SolidColorBrush x:Key="EngineeringDecorationBrush" Color="#67E8F9" />
    <SolidColorBrush x:Key="EngineeringDecorationFillBrush" Color="#67E8F9" Opacity="0.04" />
    <Color x:Key="AmberHex">#FFB224</Color>
    <Color x:Key="StrokeHex">#1F2630</Color>
    <Color x:Key="CyanDimHex">#8067E8F9</Color>
    <SolidColorBrush x:Key="PillOkBorderBrush" Color="#4ade80" Opacity="0.45" />
    <SolidColorBrush x:Key="PillBadBorderBrush" Color="#f87171" Opacity="0.45" />
    <SolidColorBrush x:Key="PillWarnBorderBrush" Color="#ffb224" Opacity="0.5" />

    <!-- keep any remaining WPF-UI chrome blending in -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#0a0c0f" />
    <SolidColorBrush x:Key="ApplicationForegroundBrush" Color="#e9e4d8" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#e9e4d8" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#a09a8c" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#5f6470" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#10141a" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#1f2630" />
</ResourceDictionary>
