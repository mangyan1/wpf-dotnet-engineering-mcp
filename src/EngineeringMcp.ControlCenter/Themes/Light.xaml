<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Fonts.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- blueprint print paper palette (docs/mockups/control-center.html [data-theme="light"]) -->
    <SolidColorBrush x:Key="BgBrush" Color="#DFE8F2" />
    <SolidColorBrush x:Key="Bg2Brush" Color="#D3DEEC" />
    <SolidColorBrush x:Key="PanelBrush" Color="#F2F7FC" />
    <SolidColorBrush x:Key="Panel2Brush" Color="#E6EDF6" />
    <SolidColorBrush x:Key="RaiseBrush" Color="#D5E0EE" />
    <SolidColorBrush x:Key="StrokeBrush" Color="#A5BAD3" />
    <SolidColorBrush x:Key="Stroke2Brush" Color="#B6C8DD" />
    <SolidColorBrush x:Key="HairBrush" Color="#8CA6C4" />
    <SolidColorBrush x:Key="GridLineBrush" Color="#C2D2E4" />
    <SolidColorBrush x:Key="TextBrush" Color="#0D2B4E" />
    <SolidColorBrush x:Key="Text2Brush" Color="#2F5079" />
    <SolidColorBrush x:Key="Text3Brush" Color="#6888AD" />
    <SolidColorBrush x:Key="AmberBrush" Color="#C25608" />
    <SolidColorBrush x:Key="AmberDimBrush" Color="#9C4A10" />
    <SolidColorBrush x:Key="AmberGlowBrush" Color="#C25608" Opacity="0.10" />
    <SolidColorBrush x:Key="AmberTextBrush" Color="#FDF8EE" />
    <SolidColorBrush x:Key="GreenBrush" Color="#15803D" />
    <SolidColorBrush x:Key="RedBrush" Color="#B91C1C" />
    <SolidColorBrush x:Key="CyanBrush" Color="#0369A1" />
    <SolidColorBrush x:Key="EngineeringDecorationBrush" Color="#0369A1" />
    <SolidColorBrush x:Key="EngineeringDecorationFillBrush" Color="#0369A1" Opacity="0.04" />
    <Color x:Key="AmberHex">#C25608</Color>
    <Color x:Key="StrokeHex">#A5BAD3</Color>
    <Color x:Key="CyanDimHex">#800369A1</Color>
    <SolidColorBrush x:Key="PillOkBorderBrush" Color="#15803D" Opacity="0.45" />
    <SolidColorBrush x:Key="PillBadBorderBrush" Color="#B91C1C" Opacity="0.45" />
    <SolidColorBrush x:Key="PillWarnBorderBrush" Color="#C25608" Opacity="0.5" />

    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#DFE8F2" />
    <SolidColorBrush x:Key="ApplicationForegroundBrush" Color="#0D2B4E" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#0D2B4E" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#2F5079" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#6888AD" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#F2F7FC" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#A5BAD3" />
</ResourceDictionary>
