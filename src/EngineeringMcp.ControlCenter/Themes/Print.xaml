<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Fonts.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Prussian-blue cyanotype print palette (docs/mockups/control-center.html [data-theme="blueprint"]) -->
    <SolidColorBrush x:Key="BgBrush" Color="#12283E" />
    <SolidColorBrush x:Key="Bg2Brush" Color="#0E2134" />
    <SolidColorBrush x:Key="PanelBrush" Color="#1A3552" />
    <SolidColorBrush x:Key="Panel2Brush" Color="#153049" />
    <SolidColorBrush x:Key="RaiseBrush" Color="#22405F" />
    <SolidColorBrush x:Key="StrokeBrush" Color="#31537A" />
    <SolidColorBrush x:Key="Stroke2Brush" Color="#2A4A6E" />
    <SolidColorBrush x:Key="HairBrush" Color="#3C6089" />
    <SolidColorBrush x:Key="GridLineBrush" Color="#22405F" />
    <SolidColorBrush x:Key="TextBrush" Color="#EAF4FF" />
    <SolidColorBrush x:Key="Text2Brush" Color="#B8D4EE" />
    <SolidColorBrush x:Key="Text3Brush" Color="#6F93B8" />
    <SolidColorBrush x:Key="AmberBrush" Color="#FFB224" />
    <SolidColorBrush x:Key="AmberDimBrush" Color="#C98A1A" />
    <SolidColorBrush x:Key="AmberGlowBrush" Color="#FFB224" Opacity="0.12" />
    <SolidColorBrush x:Key="AmberTextBrush" Color="#141005" />
    <SolidColorBrush x:Key="GreenBrush" Color="#7EE2A8" />
    <SolidColorBrush x:Key="RedBrush" Color="#FF9D9D" />
    <SolidColorBrush x:Key="CyanBrush" Color="#9BE1FF" />
    <SolidColorBrush x:Key="EngineeringDecorationBrush" Color="#BFE6FF" />
    <SolidColorBrush x:Key="EngineeringDecorationFillBrush" Color="#BFE6FF" Opacity="0.04" />
    <Color x:Key="AmberHex">#FFB224</Color>
    <Color x:Key="StrokeHex">#31537A</Color>
    <Color x:Key="CyanDimHex">#809BE1FF</Color>
    <SolidColorBrush x:Key="PillOkBorderBrush" Color="#7EE2A8" Opacity="0.45" />
    <SolidColorBrush x:Key="PillBadBorderBrush" Color="#FF9D9D" Opacity="0.45" />
    <SolidColorBrush x:Key="PillWarnBorderBrush" Color="#FFB224" Opacity="0.5" />

    <!-- keep any remaining WPF-UI chrome blending in -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#12283E" />
    <SolidColorBrush x:Key="ApplicationForegroundBrush" Color="#EAF4FF" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#EAF4FF" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#B8D4EE" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#6F93B8" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#1A3552" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#31537A" />
</ResourceDictionary>
