<Project Sdk="WixToolset.Sdk/4.0.6">
  <PropertyGroup>
    <InstallerPlatform>x64</InstallerPlatform>
    <OutputType>Package</OutputType>
    <OutputName Condition="'$(OutputName)' == ''">EngineeringMcp-Setup</OutputName>
    <DefineConstants>ProductVersion=$(ProductVersion);RepositoryRoot=$(RepositoryRoot);LicenseRtf=$(LicenseRtf)</DefineConstants>
    <SuppressIces>ICE38;ICE64;ICE91</SuppressIces>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" />
    <Compile Include="$(PayloadSourceFile)" Link="GeneratedPayload.wxs" />
  </ItemGroup>
</Project>
