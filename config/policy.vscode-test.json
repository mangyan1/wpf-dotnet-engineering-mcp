{
  "$schema": "./policy.schema.json",
  "policyVersion": 1,
  "enabledToolProfiles": [ "core", "wpf-read", "wpf-interact", "diagnostics", "source" ],
  "permissionCeiling": "ApplicationDiagnostics",
  "processes": {
    "allow": [
      {
        "name": "EngineeringMcp.Wpf.TestApp.exe",
        "path": "..\\tests\\EngineeringMcp.Wpf.TestApp\\bin\\Debug\\net10.0-windows10.0.19041.0\\EngineeringMcp.Wpf.TestApp.exe",
        "sha256": null,
        "publisher": null
      },
      {
        "name": "EngineeringMcp.AspNetCore.TestApp.exe",
        "path": "..\\tests\\EngineeringMcp.AspNetCore.TestApp\\bin\\Debug\\net10.0\\EngineeringMcp.AspNetCore.TestApp.exe",
        "sha256": null,
        "publisher": null
      }
    ]
  },
  "filesystem": {
    "readRoots": [
      ".."
    ],
    "denyGlobs": [
      "**/.env",
      "**/secrets.json",
      "**/appsettings.Production.json",
      "**/*.pfx",
      "**/*.key",
      "**/*.dmp",
      "**/*.dump",
      "**/.git/**"
    ]
  },
  "network": {
    "default": "deny",
    "allow": []
  },
  "pii": "Mask",
  "audit": {
    "enabled": true,
    "directory": null,
    "retentionDays": 7
  },
  "screenshots": {
    "enabled": true,
    "maskPasswordControls": true,
    "maskSensitiveNames": true,
    "failClosedOnRedactionError": true,
    "maskTextControls": true
  },
  "allowDestructiveActions": false,
  "allowPrivilegedDiagnostics": false,
  "uiActions": {
    "denyAutomationIds": [
      "ApiTokenPasswordBox"
    ],
    "destructiveAutomationIds": [],
    "statefulAutomationIds": [
      "SaveButton",
      "CrashButton"
    ]
  }
}
